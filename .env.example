# Copy to .env (never commit .env). Local development values; use secrets managers in the cloud.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pmp
POSTGRES_USER=pmp
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg2://pmp:change-me@localhost:5432/pmp

# "csv" reads data/raw, "postgres" reads the DBT staging tables.
DATA_SOURCE=csv
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MODEL_NAME=predictive-maintenance

# Hypothetical costs in euros (see docs/cost_assumptions.md). Replace with real figures if you have them.
COST_MISSED_FAILURE=10000
COST_USELESS_INSPECTION=500
COST_USEFUL_INSPECTION=500
INSPECTIONS_PER_DAY=5
PSI_THRESHOLD=0.2
MIN_COST_GAIN=0.02

# Optional: protect /admin routes of the API.
API_KEY=
# Optional (AWS): the API downloads the champion from here at start, promotion uploads it.
MODEL_S3_URI=
# AWS credentials: use an IAM role on EC2 / OIDC in CI. Never put access keys in this file or in Git.
AWS_REGION=eu-west-3
